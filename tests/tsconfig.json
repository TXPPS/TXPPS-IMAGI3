{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "./dist-types",
    "tsBuildInfoFile": "./dist-types/.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "include": [
    "e2e/**/*.ts",
    "../playwright.config.ts",
    "../vitest.config.ts",
    "../apps/editor/src/**/*.ts"
  ],
  "references": [
    {
      "path": "../tools/audit"
    },
    {
      "path": "../tools/repo"
    },
    {
      "path": "../packages/core"
    },
    {
      "path": "../packages/runtime"
    },
    {
      "path": "../packages/render"
    }
  ]
}
