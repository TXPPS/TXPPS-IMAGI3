{
  "name": "imagi3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "audit:budgets": "node --experimental-strip-types tools/audit/src/cli/check-budgets.ts",
    "audit:bundle": "node --experimental-strip-types tools/audit/src/cli/measure-bundle.ts",
    "audit:clean": "rm -rf .audit-out",
    "audit:profile-ordering": "node --experimental-strip-types tools/audit/src/cli/check-profile-ordering.ts",
    "audit:selftest": "vitest run --project audit-selftest",
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./tools/*\" run build && pnpm --filter @imagi3/editor run build",
    "calibrate:cpu": "node --experimental-strip-types tools/repo/src/cli/calibrate-cpu.ts",
    "clean": "git clean -xdf node_modules dist .turbo && echo cleaned",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "review:worktree": "node --experimental-strip-types tools/repo/src/cli/review-worktree.ts",
    "sweep": "pnpm audit:clean && pnpm verify && pnpm audit:bundle && pnpm test:e2e && pnpm audit:profile-ordering && pnpm audit:budgets",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm verify:claims && pnpm test && pnpm build",
    "verify:claims": "node --experimental-strip-types tools/repo/src/cli/verify-claims.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@imagi3/audit": "workspace:*",
    "@imagi3/render": "workspace:*",
    "@imagi3/repo": "workspace:*",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.0",
    "@types/three": "0.181.0",
    "eslint": "9.39.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.2.7",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "three": "0.181.0"
  }
}
